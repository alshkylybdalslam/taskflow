{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "TaskFlow — a full-stack task & project manager built with Node.js, Express and SQLite",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test tests/",
    "coverage": "c8 --reporter=text --reporter=lcov node --test tests/"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "nodejs",
    "express",
    "sqlite",
    "rest-api",
    "task-manager",
    "project-management",
    "full-stack"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  }
}
